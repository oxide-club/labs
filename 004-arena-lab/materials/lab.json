        },
        {
          "name": "checks rejeitam starter",
          "argv": [
            "{work}/arena-tests"
          ],
          "status": 1,
          "contains": "falhas"
        },
        {
          "name": "compilar falha malloc",
          "argv": [
            "cc",
            "-std=c11",
            "-Wall",
            "-Wextra",
            "-Wpedantic",
            "-Werror",
            "-O2",
            "-Imaterials/starter",
            "materials/starter/arena.c",
            "materials/checks/fail_malloc.c",
