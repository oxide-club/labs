      ],
      "experiments": {
        "default": [
          {
            "argv": [
              "{work}/vm",
              "1000"
            ],
            "stdin": "materials/expression.txt"
          }
        ]
      },
      "artifacts": [
        "build/vm"
      ],
      "preparation": [
        {
          "name": "compilar VM Rust",
          "argv": [
            "rustc",
            "--edition=2021",
            "-D",
            "warnings",
            "materials/starter/rust/main.rs",
            "-o",
            "{work}/vm"
          ]
        },
        {
          "name": "compilar teste de transporte",
          "argv": [
            "rustc",
            "--edition=2021",
            "--test",
            "materials/starter/rust/main.rs",
            "-o",
            "{work}/transport"
          ]
        },
        {
          "name": "verificar transporte",
          "argv": [
            "{work}/transport"
          ],
          "contains": "1 passed"
        },
        {
          "name": "mesmos checks rejeitam VM Rust",
          "argv": [
            "python3",
            "checks/check.py",
            "{work}/vm"
          ],
          "status": 1,
